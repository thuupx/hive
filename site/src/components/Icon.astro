---
/**
 * One icon set, one style: 24px grid, 1.75 stroke, round caps and joins.
 *
 * The shapes are built from primitives rather than lifted from an icon font, so
 * each one is a real path that renders. `github` is the exception: it is the
 * official mark, filled, and used unmodified.
 */
interface Props {
  name: keyof typeof paths;
  class?: string;
  size?: number;
}

const paths = {
  // A gateway: one upstream, two downstream.
  gateway: `
    <circle cx="12" cy="5" r="2.5" />
    <circle cx="6" cy="19" r="2.5" />
    <circle cx="18" cy="19" r="2.5" />
    <path d="M12 7.5 6.8 16.6" />
    <path d="M12 7.5l5.2 9.1" />`,

  // A conversation.
  session: `
    <rect x="3" y="4" width="18" height="13" rx="3" />
    <path d="M8 17v4l4-4" />`,

  // An agent process, as a terminal window.
  agent: `
    <rect x="3" y="4" width="18" height="16" rx="2" />
    <path d="M7 9.5 10.5 12 7 14.5" />
    <path d="M13 14.5h4" />`,

  // A machine that runs agents.
  node: `
    <rect x="3" y="4" width="18" height="6" rx="2" />
    <rect x="3" y="14" width="18" height="6" rx="2" />
    <path d="M7 7h.01M7 17h.01" />`,

  // Fail closed.
  shield: `
    <path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z" />
    <path d="M9 12l2 2 4-4" />`,

  // Hand a session to another agent.
  handoff: `
    <path d="M3 8h18" />
    <path d="M17 4.5 20.5 8 17 11.5" />
    <path d="M21 16H3" />
    <path d="M7 12.5 3.5 16 7 19.5" />`,

  // Durable storage.
  database: `
    <ellipse cx="12" cy="6" rx="8" ry="3" />
    <path d="M4 6v12c0 1.66 3.58 3 8 3s8-1.34 8-3V6" />
    <path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3" />`,

  // A plugin, at a process boundary.
  plug: `
    <path d="M9 3v6M15 3v6" />
    <path d="M6 9h12v4a6 6 0 0 1-12 0z" />
    <path d="M12 19v2" />`,

  terminal: `
    <rect x="3" y="4" width="18" height="16" rx="2" />
    <path d="M7 9l3 3-3 3" />
    <path d="M13 15h4" />`,

  copy: `
    <rect x="9" y="9" width="11" height="11" rx="2" />
    <path d="M5 15V6a2 2 0 0 1 2-2h9" />`,

  check: `<path d="M5 13l4 4L19 7" />`,

  arrow: `
    <path d="M4 12h15" />
    <path d="M13 6l6 6-6 6" />`,

  book: `
    <path d="M12 6.5C10 4.5 6.5 4.3 4 5.2v13.4c2.5-.9 6-.7 8 1.3" />
    <path d="M12 6.5c2-2 5.5-2.2 8-1.3v13.4c-2.5-.9-6-.7-8 1.3" />
    <path d="M12 6.5V20" />`,

  menu: `<path d="M4 7h16M4 12h16M4 17h16" />`,

  close: `<path d="M6 6l12 12M18 6L6 18" />`,

  // Official GitHub mark. Filled, unmodified.
  github: `
    <path fill="currentColor" stroke="none" d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.6 8.2 11.16.6.11.82-.25.82-.57v-2.2c-3.34.71-4.04-1.6-4.04-1.6-.55-1.38-1.34-1.75-1.34-1.75-1.1-.74.08-.73.08-.73 1.2.08 1.84 1.22 1.84 1.22 1.08 1.82 2.83 1.3 3.52.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.31-5.47-5.84 0-1.29.47-2.34 1.24-3.17-.13-.3-.54-1.52.12-3.16 0 0 1.01-.32 3.3 1.21a11.5 11.5 0 0 1 6 0c2.29-1.53 3.3-1.21 3.3-1.21.66 1.64.25 2.86.12 3.16.77.83 1.24 1.88 1.24 3.17 0 4.54-2.81 5.53-5.49 5.83.43.36.81 1.1.81 2.22v3.29c0 .32.21.69.83.57A12.02 12.02 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z" />`,
} as const;

const { name, class: className = "", size = 24 } = Astro.props;
const filled = name === "github";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={filled ? "none" : "currentColor"}
  stroke-width={filled ? 0 : 1.75}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
