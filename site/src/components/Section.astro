---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { id, eyebrow, title, lead } = Astro.props;
---

<section id={id} class="rule">
  <div class="container-page py-20 sm:py-24">
    <div class="max-w-2xl">
      {
        eyebrow && (
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
            {eyebrow}
          </p>
        )
      }
      <h2 class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-4xl">
        {title}
      </h2>
      {lead && <p class="mt-4 text-pretty text-lg leading-relaxed text-muted-foreground">{lead}</p>}
    </div>

    <div class="mt-12 sm:mt-14">
      <slot />
    </div>
  </div>
</section>
