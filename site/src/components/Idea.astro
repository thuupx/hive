---
import Icon from "./Icon.astro";
import Section from "./Section.astro";

const layers = [
  {
    icon: "session",
    name: "Transport",
    role: "Presentation",
    detail: "Any messaging app, a terminal, or a client you write. A transport resolves its own commands and never holds orchestration.",
  },
  {
    icon: "gateway",
    name: "Session",
    role: "The conversation",
    detail: "Hive's own object. Durable, transport-agnostic, and yours. It outlives the agent that happens to be answering.",
  },
  {
    icon: "agent",
    name: "AgentRun",
    role: "Execution",
    detail: "One agent process on one node. Handing a session to another agent creates a new run; the old runtime session is left untouched.",
  },
] as const;
---

<Section
  id="idea"
  eyebrow="The idea"
  title="Separate the three things everyone else welds together"
  lead="A bridge makes one conversation equal one agent session. Hive keeps them apart, and the rest follows from that. The same separation is why the transport is not special: swap the chat app and nothing above it moves."
>
  <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
    <ol class="space-y-4">
      {
        layers.map((layer, index) => (
          <li class="card flex gap-4 p-5">
            <span class="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-muted text-accent">
              <Icon name={layer.icon} size={20} />
            </span>
            <div>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="font-mono text-base font-semibold">{layer.name}</h3>
                <span class="text-xs uppercase tracking-wider text-muted-foreground">
                  {layer.role}
                </span>
              </div>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                {layer.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <figure class="flex flex-col justify-center">
      <blockquote
        class="border-l-2 border-accent pl-5 text-lg italic leading-relaxed text-foreground/90"
      >
        Hive owns orchestration and context. Agents own execution and tool
        semantics. Transports own presentation and delivery.
      </blockquote>
      <figcaption class="mt-3 pl-5 text-sm text-muted-foreground">
        The principle the whole design is derived from.
      </figcaption>
    </figure>
  </div>
</Section>
