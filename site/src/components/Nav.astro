---
import Icon from "./Icon.astro";
import { REPO } from "../site";

const links = [
  { href: "#problem", label: "Why" },
  { href: "#idea", label: "How" },
  { href: "#portable", label: "Portable" },
  { href: "#compare", label: "Compare" },
  { href: "#security", label: "Security" },
  { href: "#start", label: "Start" },
];
---

<header
  class="sticky top-0 z-40 border-b border-hairline bg-background/85 backdrop-blur"
>
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a
      href="#top"
      class="flex items-center gap-2.5 rounded-md text-base font-semibold tracking-tight"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true">
        <path
          d="M12 2.5 20.3 7.3v9.4L12 21.5 3.7 16.7V7.3z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linejoin="round"></path>
        <circle cx="12" cy="12" r="2.75" fill="#22c55e"></circle>
      </svg>
      Hive
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Sections">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors duration-200 hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={REPO}
        class="inline-flex items-center gap-2 rounded-md border border-border px-3 py-1.5 text-sm font-medium transition-colors duration-200 hover:border-accent hover:text-accent"
      >
        <Icon name="github" size={16} />
        <span class="hidden sm:inline">GitHub</span>
      </a>

      <button
        id="nav-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-md border border-border p-1.5 md:hidden"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Open menu"
      >
        <span id="nav-open"><Icon name="menu" size={18} /></span>
        <span id="nav-close" class="hidden"><Icon name="close" size={18} /></span>
      </button>
    </div>
  </div>

  <div id="nav-menu" hidden class="border-t border-hairline md:hidden">
    <nav class="container-page flex flex-col py-2" aria-label="Sections">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-1 py-3 text-sm text-muted-foreground hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  const openIcon = document.getElementById("nav-open");
  const closeIcon = document.getElementById("nav-close");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    menu?.toggleAttribute("hidden", open);
    openIcon?.classList.toggle("hidden", !open);
    closeIcon?.classList.toggle("hidden", open);
  });

  // A link that navigates should close the menu it was chosen from.
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => toggle?.click());
  });
</script>
